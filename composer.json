{
    "name": "joranski/laravel-addressing",
    "version": "0.3.0",
    "description": "Universal address handling for Laravel: commerceguys-backed format validation, pluggable verifier chain (Google, Null, custom), form-data verification service, Flux address-field Blade components, and a HasAddresses trait with shipping/billing defaults via pivot.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "commerceguys/addressing": "^2.2",
        "illuminate/contracts": "^12.0 || ^13.0",
        "illuminate/database": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0",
        "illuminate/validation": "^12.0 || ^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0"
    },
    "suggest": {
        "livewire/flux": "Required for the <x-addressing::fields> and <x-addressing::google-places-autocomplete> Blade components."
    },
    "autoload": {
        "psr-4": {
            "Joranski\\Addressing\\": "src/",
            "Joranski\\Addressing\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Joranski\\Addressing\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Joranski\\Addressing\\AddressingServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "vendor/bin/pest --compact"
    }
}
